# Dependencies (reinstalled inside the image)
**/node_modules

# Build output
**/dist
**/build
**/.vite
**/coverage

# Environment files (inject at runtime, never bake into images)
**/.env
**/.env.*
!**/.env.example

# Version control
.git
.gitignore
.gitattributes

# Docker files (not needed inside the image)
**/Dockerfile*
**/docker-compose*.yml
**/compose*.yml
.dockerignore

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Editor / OS files
.vscode
.idea
**/.DS_Store
**/Thumbs.db

# Docs and misc
README.md
**/*.md
**/.eslintcache

# Local database data
**/pgdata
**/postgres-data